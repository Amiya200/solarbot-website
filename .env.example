# Public React contact destinations (safe to expose to the browser)
REACT_APP_WHATSAPP_NUMBER=91XXXXXXXXXX
REACT_APP_CONTACT_EMAIL=you@example.com
REACT_APP_BOOKING_API_URL=/.netlify/functions/booking

# Netlify function / server-side only — NEVER commit real values for these.
# Set the real values in the Netlify dashboard (Site settings -> Environment variables).
BOOKING_NOTIFICATION_EMAIL=you@example.com
BOOKING_FROM_EMAIL=SolarBot <bookings@yourdomain.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAxxxxxxxxxxxxxxxx
ALLOWED_ORIGIN=https://www.yourdomain.com
